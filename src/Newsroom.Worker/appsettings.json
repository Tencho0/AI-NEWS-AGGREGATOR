{
  "ConnectionStrings": {
    "Newsroom": "Server=.\\SQLEXPRESS;Database=Newsroom;Integrated Security=True;TrustServerCertificate=True;Encrypt=True"
  },
  "Worker": {
    "HeartbeatSeconds": 60
  },
  "Scrape": {
    "CheckSeconds": 60,
    "MinTextLength": 400,
    "FetchFullText": true,
    "DisableAfterFailingHours": 24,
    "UserAgent": "PredelNewsBot/1.0 (+https://predel.news/bot)"
  },
  "Ai": {
    "RequestsPerMinute": 8,
    "// RequestTimeoutSeconds": "How long a Gemini call may stall before it is abandoned. The Google SDK builds these clients itself, so they get no AddHttpClient timeout and no Polly handler; 100 is the HttpClient default the worker inherited implicitly until 2026-08-05. 0 or less = leave the SDK's own default.",
    "RequestTimeoutSeconds": 100,
    "Gemini": {
      "ApiKey": ""
    },
    "// Categories and Regions": "MUST match the site's taxonomy node names exactly. The publishing endpoint resolves both by name and REJECTS the whole publish on an unknown value (NewsroomPublishingService.ResolveTaxonomyNode). Source of truth: Predel-News src/Web/PredelNews.Web/Setup/TaxonomySeedSetup.cs. Corrected 2026-08-04 after the first live publish failed with: Unknown category \"Икономика\".",
    "Categories": [
      "Общество",
      "Политика",
      "Криминално",
      "Икономика / Бизнес",
      "Спорт",
      "Култура",
      "Любопитно",
      "Хайлайф"
    ],
    "Regions": [
      "Благоевград",
      "Кюстендил",
      "Перник",
      "София",
      "България"
    ],
    "Prices": {
      "InputPerMTok": 0,
      "OutputPerMTok": 0
    },
    "Stages": {
      "Analyse": {
        "Model": "gemini-3.1-flash-lite",
        "BatchSize": 8,
        "DailyRequestBudget": 450,
        "MaxAttempts": 3,
        "CheckSeconds": 120
      },
      "Cluster": {
        "Model": "gemini-2.5-flash",
        "BatchSize": 30,
        "DailyRequestBudget": 18,
        "CheckSeconds": 300,
        "RecentTitlesPerTopic": 3
      },
      "Draft": {
        "Model": "gemini-3.1-flash-lite",
        "DailyRequestBudget": 40,
        "CheckSeconds": 300,
        "MaxPerCycle": 2,
        "MaxAttempts": 2,
        "MaxArticlesPerBundle": 6,
        "MaxTextCharsPerArticle": 6000
      },
      "SelfCheck": {
        "Model": "gemini-3.5-flash",
        "DailyRequestBudget": 9
      },
      "Image": {
        "DailyRequestBudget": 60
      }
    }
  },
  "Images": {
    "MaxSuggestions": 3,
    "StorageRoot": "",
    "EditorUploadDir": "editor-uploads",
    "Cover": {
      "LogoFile": "branding/predel-news-logo.png",
      "LogoCorner": "UpperRight",
      "LogoWidthPercent": 26,
      "LogoMarginPercent": 3,
      "BurnInText": false
    },
    "Pixabay": {
      "ApiKey": ""
    },
    "Pexels": {
      "ApiKey": ""
    },
    "Cloudflare": {
      "Enabled": false,
      "AccountId": "",
      "ApiToken": "",
      "Model": "@cf/black-forest-labs/flux-2-klein-4b",
      "RequestFormat": "Multipart",
      "Steps": 0,
      "Guidance": 0,
      "Width": 1280,
      "Height": 720,
      "TransientRetries": 2,
      "TransientRetryDelaySeconds": 3,
      "GeneratedImageDir": "generated-images",
      "ReferenceImageDir": "public-figures",
      "AllowPublicFiguresInSensitiveCategories": false
    },
    "PublicFigures": []
  },
  "Telegram": {
    "BotToken": "",
    "ReviewChatId": 0,
    "AllowedUserIds": [],
    "ReviewTtlHours": 12,
    "PollTimeoutSeconds": 25,
    "MaxSendPerCycle": 5
  },
  "Umbraco": {
    "BaseUrl": "",
    "ClientId": "newsroom-bot",
    "ClientSecret": "",
    "MaxAttempts": 3,
    "CheckSeconds": 60
  },
  "Facebook": {
    "PageId": "",
    "AccessToken": "",
    "GraphVersion": "v23.0",
    "DryRun": true,
    "MaxAttempts": 3,
    "Schedule": {
      "Windows": ["07:30-09:30", "12:00-13:30", "17:30-21:30"],
      "MinGapMinutes": 90,
      "MaxPerDay": 5,
      "LeadMinutes": 5
    }
  },
  "Publishing": {
    "FacebookOnly": false
  },
  "Watchdog": {
    "CheckSeconds": 300
  },
  "Digest": {
    "LocalTime": "09:00"
  },
  "Retention": {
    "ExtractedTextDays": 90,
    "LogDays": 90,
    "GeneratedImageDays": 14,
    "EditorUploadDays": 30,
    "PublishedImageDays": 30,
    "ImageBatch": 500
  },
  "Trend": {
    "WindowHours": 48,
    "HotThreshold": 6.0,
    "ArticlesWeight": 2.0,
    "SourcesWeight": 2.0,
    "VelocityWeight": 1.0,
    "RegionWeight": 3.0,
    "HalfLifeHours": 12.0,
    "VelocityWindowHours": 6.0
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System.Net.Http.HttpClient": "Warning",
        "Polly": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/newsroom-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "// MSSqlServer": "Warning+ into nw_Log, the queryable history docs/07-operations.md has always promised. The table has existed since migration 0001 (shaped for this sink's standard columns) and RetentionJob already prunes it, but the sink itself was never wired, so the runbooks pointed at an empty table. autoCreateSqlTable is off: the migration owns the schema. Failures are swallowed by the sink, so an unreachable database costs log history, not the worker.",
        "Name": "MSSqlServer",
        "Args": {
          "connectionString": "Newsroom",
          "restrictedToMinimumLevel": "Warning",
          "sinkOptionsSection": {
            "schemaName": "dbo",
            "tableName": "nw_Log",
            "autoCreateSqlTable": false,
            "batchPostingLimit": 50,
            "period": "0.00:00:05"
          },
          "columnOptionsSection": {
            "timeStamp": {
              "columnName": "TimeStamp",
              "convertToUtc": true
            }
          }
        }
      }
    ]
  }
}
